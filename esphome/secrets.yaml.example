# Copy to secrets.yaml (gitignored) and fill in.

# Home network (2.4 GHz, WPA2 or WPA2/WPA3 mixed — ESP8266 has no 5 GHz / WPA3-only)
wifi_ssid: "<your wifi ssid>"
wifi_password: "<your wifi password>"

# Fixed IP for the feeder: pick one OUTSIDE your router's DHCP pool.
feeder_home_ip: 192.168.1.40
home_gateway: 192.168.1.1
home_subnet: 255.255.255.0

# Future IoT VLAN (also uncomment the second network in feeder.yaml)
# iot_wifi_ssid: "<iot ssid>"
# iot_wifi_password: "<iot password>"
# feeder_iot_ip: 192.168.20.40
# iot_gateway: 192.168.20.1
# iot_subnet: 255.255.255.0
